---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import Icon from '../components/Icon.astro';
import ProcessCards from '../components/ProcessCards.astro';
import ProjectCard from '../components/ProjectCard.astro';
import MapEmbed from '../components/MapEmbed.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
import { servizi } from '../data/servizi';
import { team } from '../data/team';
import { progetti, progetto } from '../data/progetti';
import { heroSlides, progettiHome, numeriHome, aree } from '../data/contenuti';

const title = 'Progetto Service | Impresa edile e ristrutturazioni a Crema';
const description = site.descrizione;
const fotoStudio = progetto('open-space').immagini[0];
---
<Layout title={title} description={description} transparent>
<section class="hero" aria-label="Lavori in evidenza"> <div class="hero-slides" data-hero> {heroSlides.map((s, i) => <figure class:list={['hero-slide', { 'is-active': i === 0 }]} data-title={s.titolo} data-location={s.luogo} data-href={s.href}> <Picture img={s.img} eager={i === 0} class="full-img" /> </figure>)} </div> <div class="container hero-content"> <p class="eyebrow-light mb-3">{site.nome} · {site.attivita} · {site.indirizzo.citta}</p> <h1 class="h1">Ristrutturazioni <em>chiavi in mano</em></h1> <div class="hero-meta"> <div> <p class="lead">Impresa edile a Crema: ristrutturazioni complete, bagni, tetti e manutenzioni a Crema, Lodi, Milano e provincia. Un unico referente, dall'inizio alla fine.</p> <div class="btn-row"> <a href="/progetti/" class="btn btn-primary">Vedi i lavori</a> <a href="/contatti/#richiesta" class="btn btn-outline-light">Contattaci</a> </div> </div> <div class="hero-caption" aria-live="polite"> <span class="label">In foto</span> <a href={heroSlides[0].href} class="link-underline" data-hero-caption>{heroSlides[0].titolo} · {heroSlides[0].luogo}</a> <div class="hero-dots" role="group" aria-label="Scegli l'immagine"> {heroSlides.map((s, i) => <button type="button" aria-label={`Mostra ${s.titolo}`} aria-current={i === 0 ? 'true' : 'false'} data-dot={i}></button>)} </div> </div> </div> </div> </section>

<section class="section"> <div class="container split"> <div class="reveal"> <div class="ratio-45"> <Picture img={fotoStudio} sizes="(min-width: 1024px) 38vw, 92vw" /> </div> </div> <div class="reveal"> <p class="eyebrow mb-2">Chi siamo</p> <h2 class="h2">Un unico referente, dal 2013</h2> <div class="prose mt-3 lead"> <p>Progetto Service è un'impresa edile di Crema che segue ogni cliente con la formula "chiavi in mano".</p> <p>Nata nel 2013 dall'esperienza trentennale del titolare nel settore edile, interviene con serietà e professionalità su privati e aziende, a 360°.</p> </div> <div class="stats mt-4"> {numeriHome.map((s) => <div class="stat"><strong>{s.n}</strong><span>{s.label}</span></div>)} </div> <a href="/studio/" class="btn btn-outline mt-4">Scopri l'azienda</a> </div> </div> </section>

<section class="section bg-sand"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow mb-2">Servizi</p> <h2 class="h2">Di cosa ci occupiamo</h2> <p class="lead mt-2">Dalla ristrutturazione completa alle singole lavorazioni.</p> </div> <a href="/servizi/" class="btn btn-outline">Tutti i servizi</a> </div> <ul class="services services-3 reveal"> {servizi.map((s) => <li class="service"> <Icon name={s.icona} class="icon" /> <h3 class="h4"><a href={`/servizi/#${s.id}`} class="link-underline">{s.nome}</a></h3> <p>{s.breve}</p> </li>)} </ul> </div> </section>

<section class="section"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Valori</p> <h2 class="h2">Professionalità, serietà, celerità</h2> </div> <a href="/metodo/" class="text-link link-underline">I nostri valori</a> </div> <ProcessCards /> </div> </section>

<section class="section" style="padding-top: 0"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Lavori</p> <h2 class="h2">Alcuni dei nostri lavori</h2> </div> <a href="/progetti/" class="text-link link-underline">Tutti i lavori</a> </div> <div class="projects-grid"> {progettiHome.map((slug) => <ProjectCard p={progetto(slug)} />)} </div> </div> </section>

<section class="section bg-ink"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Dove lavoriamo</p> <h2 class="h2">A Crema, Lodi, Milano e provincia</h2> <p class="lead mt-2" style="color: rgb(255 255 255 / 0.72)">Con sede a Crema, interveniamo in tutta la provincia di Cremona e nelle zone di Lodi e Milano.</p> </div> </div> <ul class="areas reveal"> {aree.map((a) => <li class="area"> <span>{a.conteggio}</span> <strong>{a.nome}</strong> <p>{a.comuni}</p> </li>)} </ul> </div> </section>

<section class="section"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Team</p> <h2 class="h2">Il titolare e la squadra</h2> <p class="lead mt-2">Giovanni e una squadra dall'esperienza ventennale.</p> </div> <a href="/studio/#team" class="text-link link-underline">Conosci l'azienda</a> </div> <div class="team-strip reveal"> {team.slice(0, 7).map((m) => <a href={`/studio/#${m.id}`} title={`${m.nome}, ${m.ruolo}`}> <Picture img={m.foto} sizes="(min-width: 768px) 14vw, 33vw" /> </a>)} </div> </div> </section>


<section class="section"> <div class="container grid-2"> <div class="reveal"> <p class="eyebrow mb-2">Dove siamo</p> <h2 class="h2">{site.nome} a {site.indirizzo.citta}</h2> <p class="lead mt-3">Il nostro ufficio è a Crema, in Via IV Novembre 10. Scrivici o chiamaci per fissare un sopralluogo.</p> <div class="contact-cards mt-4"> <div class="contact-card"> <h3>Sede</h3> <p>{site.indirizzo.via}<br>{site.indirizzo.cap} {site.indirizzo.citta} ({site.indirizzo.provincia}), Italia</p> <a href={site.mapsUrl} target="_blank" rel="noopener" class="text-link link-underline mt-1" style="display:inline-block">Apri in Google Maps</a> </div> <div class="contact-card"> <h3>Orari</h3> <p>{site.ricevimento}</p> </div> <div class="contact-card"> <h3>Contatti</h3> {site.telefono && <p><a href={`tel:${site.telefonoE164}`}>{site.telefono}</a></p>} <p><a href={`mailto:${site.email}`}>{site.email}</a></p> </div> </div> </div> <div class="map reveal"> <MapEmbed span={0.012} /> </div> </div> </section>
<Cta />
<script>
var e=document.querySelector(`[data-hero]`);if(e){let t=[...e.querySelectorAll(`.hero-slide`)],n=[...document.querySelectorAll(`[data-dot]`)],r=document.querySelector(`[data-hero-caption]`),i=window.matchMedia(`(prefers-reduced-motion: reduce)`).matches,a=0,o,s=e=>{t[a].classList.remove(`is-active`),n[a].setAttribute(`aria-current`,`false`),a=(e+t.length)%t.length;let i=t[a];i.querySelectorAll(`img`).forEach(e=>e.setAttribute(`loading`,`eager`)),i.classList.add(`is-active`),n[a].setAttribute(`aria-current`,`true`),r&&(r.textContent=`${i.dataset.title} · ${i.dataset.location}`,r.href=i.dataset.href||`#`)},c=()=>{i||(o=window.setInterval(()=>s(a+1),6e3))};n.forEach((e,t)=>e.addEventListener(`click`,()=>{window.clearInterval(o),s(t),c()})),window.addEventListener(`load`,()=>t.forEach(e=>e.querySelectorAll(`img`).forEach(e=>e.setAttribute(`loading`,`eager`)))),c()}
</script>
</Layout>
