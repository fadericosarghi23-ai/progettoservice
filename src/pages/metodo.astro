---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ProcessCards from '../components/ProcessCards.astro';
import Cta from '../components/Cta.astro';
import { progetto } from '../data/progetti';
import { fasi } from '../data/contenuti';

// La pagina /metodo/ ospita "I nostri valori" (P.S.C.) e l'elenco delle lavorazioni.
const crumbs = [{ name: 'Home', href: '/' }, { name: 'Valori', href: '/metodo/' }];
const hero = progetto('open-space').immagini[0];
---
<Layout title="I nostri valori | Progetto Service, impresa edile a Crema" description="I valori di Progetto Service: professionalità, serietà e celerità, con la formula chiavi in mano. Ristrutturazioni e manutenzioni a Crema, Lodi e Milano." ogType="article" transparent crumbs={crumbs}>
<PageHero img={hero} crumbs={crumbs} eyebrow="Valori"> <h1 class="h1-page">I nostri valori</h1> <p class="lead">Professionalità, serietà e celerità: la nostra forza, riassunta nel P.S.C.</p> </PageHero>
<section class="section"> <div class="container"> <ProcessCards h="h2" /> </div> </section>
<section class="section bg-sand"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow mb-2">Cosa facciamo</p> <h2 class="h2">Le nostre lavorazioni</h2> <p class="lead mt-2">Interveniamo su ogni tipo di lavorazione edile, utilizzando solo prodotti di alta qualità.</p> </div> <a href="/servizi/" class="btn btn-primary">Tutti i servizi</a> </div> <ol class="steps"> {fasi.map((f, i) => <li id={`fase-${i + 1}`} class="reveal" style={`transition-delay:${(i % 3) * 60}ms`}> <span class="n">{String(i + 1).padStart(2, '0')}</span> <h3 class="h4">{f.titolo}</h3> <p>{f.testo}</p> </li>)} </ol> </div> </section>
<Cta />
</Layout>
