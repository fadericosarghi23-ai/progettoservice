---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import Picture from '../components/Picture.astro';
import Cta from '../components/Cta.astro';
import { site } from '../data/site';
import { team } from '../data/team';
import { progetto } from '../data/progetti';
import { numeriStudio, approccio, competenzeStudio } from '../data/contenuti';

const crumbs = [{ name: 'Home', href: '/' }, { name: 'Chi siamo', href: '/studio/' }];
const hero = progetto('open-space').immagini[0];
const foto = [progetto('cucina').immagini[0], progetto('corridoio-led').immagini[0]];
// La squadra: i mestieri dell'impresa (il sito attuale non pubblica i nomi dei singoli).
const persone = ['Muratori', 'Piastrellisti', 'Imbianchini e decoratori', 'Cartongessisti', 'Idraulici', 'Elettricisti'];
---
<Layout title="Chi siamo | Progetto Service, impresa edile a Crema" description="Progetto Service è un'impresa edile di Crema, nata nel 2013 dall'esperienza trentennale del titolare: ristrutturazioni chiavi in mano a Crema, Lodi e Milano." pageType="AboutPage" ogType="article" transparent crumbs={crumbs}>
<PageHero img={hero} crumbs={crumbs} eyebrow="Chi siamo"> <h1 class="h1-page">Impresa edile <em style="color: var(--accent-on-dark)">a Crema</em></h1> <p class="lead">Un partner unico per privati e aziende: ristrutturazioni, manutenzioni e gestione del patrimonio immobiliare.</p> </PageHero>
<section class="section"> <div class="container split"> <div class="reveal"> <p class="eyebrow mb-2">L'azienda</p> <h2 class="h2">{site.nome}</h2> </div> <div class="prose lead reveal"> <p>Progetto Service è una società di servizi nata nel 2013 dall'esperienza trentennale del titolare nel settore edile delle costruzioni, per soddisfare le richieste dei clienti a 360°.</p> <p>Un unico referente responsabile segue ogni lavoro in modo veloce, pratico e sicuro, garantendo affidabilità su tutte le lavorazioni, i prodotti e i servizi.</p> </div> </div> <div class="container mt-4"> <div class="stats reveal"> {numeriStudio.map((s) => <div class="stat"><strong>{s.n}</strong><span>{s.label}</span></div>)} </div> </div> </section>
<section class="section bg-sand"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Valori</p> <h2 class="h2">Professionalità, serietà, celerità</h2> </div> </div> <div class="grid" style="grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr)); gap: 2.5rem"> {approccio.map((a, i) => <div class="reveal border-top" style={`padding-top:1.5rem; transition-delay:${i * 80}ms`}> <p class="eyebrow mb-2">{String(i + 1).padStart(2, '0')}</p> <h3 class="h3 mb-2">{a.titolo}</h3> <p>{a.testo}</p> </div>)} </div> <div class="grid-2 mt-4"> {foto.map((f) => <div class="ratio-32 reveal"><Picture img={f} sizes="(min-width: 1024px) 45vw, 92vw" /></div>)} </div> </div> </section>
<section class="section" id="team"> <div class="container"> <div class="section-head reveal"> <div> <p class="eyebrow">Il titolare</p> <h2 class="h2">Chi c'è dietro {site.nome}</h2> <p class="lead mt-2">Giovanni guida l'impresa e una squadra dall'esperienza ventennale.</p> </div> </div> <ul class="team-grid"> {team.map((m, i) => <li class="member reveal" id={m.id} style={`transition-delay:${(i % 4) * 60}ms`}> <div class="photo"><Picture img={m.foto} sizes="(min-width: 1100px) 22vw, (min-width: 768px) 30vw, 46vw" /></div> <h3>{m.nome}</h3> <p>{m.ruolo}</p> {m.bio && <p style="text-transform:none; letter-spacing:0; color:var(--text); font-size:.9375rem; font-weight:400; line-height:1.6; margin-top:.9rem">{m.bio}</p>} </li>)} </ul> <div class="mt-4 reveal"> <p class="eyebrow mb-2">La squadra</p> <ul class="checklist" style="columns: 2; column-gap: 2.5rem">{persone.map((x) => <li>{x}</li>)}</ul> </div> </div> </section>
<section class="section bg-sand"> <div class="container grid-2"> <div class="reveal"> <p class="eyebrow mb-2">Sede</p> <h2 class="h2">{site.indirizzo.citta}</h2> <p class="lead mt-3">{site.indirizzo.via}, {site.indirizzo.cap} {site.indirizzo.citta} ({site.indirizzo.provincia}), Italia.</p> <div class="btn-row mt-4"> <a href="/contatti/" class="btn btn-primary">Contattaci</a> <a href={site.mapsUrl} target="_blank" rel="noopener" class="btn btn-outline">Indicazioni per {site.indirizzo.citta}</a> </div> </div> <div class="reveal"> <ul class="checklist lead"> {competenzeStudio.map((c) => <li>{c}</li>)} </ul> </div> </div> </section>
<Cta />
</Layout>
